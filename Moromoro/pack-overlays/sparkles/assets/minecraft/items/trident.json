{
    "model": {
      "type": "range_dispatch",
      "property": "custom_model_data",
      "entries": [
        {
          "threshold": 1450006,
          "model": {
            "type": "select",
            "property": "display_context",
            "cases": [
              {
                "when": ["gui","ground","fixed"],
                "model": {
                  "type": "model",
                  "model": "incendium:item/voltaic/voltaic"
                }
              }
            ],
            "fallback": {
              "type": "condition",
              "property": "using_item",
              "on_true": {
                "type": "model",
                "model": "incendium:item/voltaic/voltaic_throwing"
              },
              "on_false": {
                "type": "model",
                "model": "incendium:item/voltaic/voltaic_holding"
              }
            }
          }
        }
      ],
      "fallback": {
        "type": "select",
        "property": "display_context",
        "cases": [
          {
            "when": ["gui","ground","fixed"],
            "model": {
              "type": "model",
              "model": "item/trident"
            }
          }
        ],
        "fallback": {
          "type": "condition",
          "property": "using_item",
          "on_true": {
            "type": "special",
            "base": "item/trident_throwing",
            "model": {
              "type": "trident"
            }
          },
          "on_false": {
            "type": "special",
            "base": "item/trident_in_hand",
            "model": {
              "type": "trident"
            }
          }
        }
      }
    }
  }
  