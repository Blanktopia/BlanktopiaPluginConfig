{
	"model": {
	  "type": "select",
	  "property": "custom_model_data",
	  "cases": [
		{
		  "when": "dnt:chart",
		  "model": {
			"type": "model",
			"model": "dnt:item/chart",
			"tints": [
			  {
				"type": "constant",
				"value": -1
			  },
			  {
				"type": "map_color",
				"default": 4603950
			  }
			]
		  }
		},
		{
			"when": "dnt:folded_chart",
			"model": {
			  "type": "model",
			  "model": "dnt:item/folded_chart",
			  "tints": [
				{
				  "type": "constant",
				  "value": -1
				},
				{
				  "type": "map_color",
				  "default": 4603950
				}
			  ]
			}
		  }
	  ],
	  "fallback": {
		"type": "model",
		"model": "item/filled_map",
		"tints": [
		  {
			"type": "constant",
			"value": -1
		  },
		  {
			"type": "map_color",
			"default": 4603950
		  }
		]
	  }
	}
  }